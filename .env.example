# Copy this file to .env and edit your copy. Never commit .env to Git.
# This file contains placeholders only. Do not put real secrets here.

# Leave the placeholder as it is to run in DEMO mode (no API calls, no cost).
# Replace it with your own key to use Claude.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SECONDS=30

# Set to true to force demo mode even when a real key is present.
DEMO_MODE=false

MAX_UPLOAD_MB=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# Relative paths are resolved from the project folder.
DATABASE_PATH=data/documind.db
LOG_LEVEL=INFO
